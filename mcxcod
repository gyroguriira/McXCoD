"""Preflight: every sheet cell filled, every reference resolves, every id has a model, texture and lang entry."""
import json, os, sys
R = "src/main/resources/"
S = lambda n: json.load(open(R + f"data/ghostdrop/sheets/{n}.json"))
lang = json.load(open(R + "assets/ghostdrop/lang/en_us.json"))
problems = []
def walk(path, v):
    if v is None or v == "" or v == [] : problems.append(f"unfilled cell: {path}")
    elif isinstance(v, dict): [walk(f"{path}.{k}", x) for k, x in v.items()]
    elif isinstance(v, list): [walk(f"{path}[{i}]", x) for i, x in enumerate(v)]
sheets = {n: S(n) for n in ("weapons", "armor", "crate", "mobs")}
for n, s in sheets.items(): walk(n, s)
item_ids = {sheets["weapons"]["rifle"]["id"], sheets["weapons"]["knife"]["id"]} | {p["id"] for p in sheets["armor"]["pieces"]}
for i in sheets["crate"]["loadout"]:
    if i not in item_ids: problems.append(f"crate.loadout references unknown item: {i}")
if {p["slot"] for p in sheets["armor"]["pieces"]} != {"helmet", "chestplate", "leggings", "boots"}: problems.append("armor.pieces must cover all four slots")
for i in item_ids:
    for f in (f"assets/ghostdrop/models/item/{i}.json", f"assets/ghostdrop/textures/item/{i}.png"):
        if not os.path.exists(R + f): problems.append(f"missing file: {f}")
    if f"item.ghostdrop.{i}" not in lang: problems.append(f"missing lang key for item {i}")
cid = sheets["crate"]["id"]
for f in (f"assets/ghostdrop/models/item/{cid}.json", f"assets/ghostdrop/models/block/{cid}.json", f"assets/ghostdrop/blockstates/{cid}.json", f"assets/ghostdrop/textures/block/{cid}.png"):
    if not os.path.exists(R + f): problems.append(f"missing file: {f}")
if f"block.ghostdrop.{cid}" not in lang: problems.append("missing lang key for crate")
layer = sheets["armor"]["material"]["layer"]
for n in (1, 2):
    if not os.path.exists(R + f"assets/ghostdrop/textures/models/armor/{layer}_layer_{n}.png"): problems.append(f"missing armor layer {n}")
if sheets["mobs"]["minRadius"] > sheets["mobs"]["maxRadius"]: problems.append("mobs.minRadius > maxRadius")
print("PREFLIGHT:", "CLEAN" if not problems else f"{len(problems)} problem(s)")
[print(" -", p) for p in problems]
sys.exit(1 if problems else 0)
