import net.minecraft.util.math.BlockPos;
import net.minecraft.world.World;
import com.google.gson.JsonElement;

/** Right-click to equip the loadout listed in crate.json. The crate is consumed. */
public class SupplyCrateBlock extends Block {
    public static final MapCodec<SupplyCrateBlock> CODEC = createCodec(SupplyCrateBlock::new);

    public SupplyCrateBlock(AbstractBlock.Settings settings) { super(settings); }

    @Override
    protected MapCodec<? extends Block> getCodec() { return CODEC; }

    @Override
    protected ActionResult onUse(BlockState state, World world, BlockPos pos, PlayerEntity player, BlockHitResult hit) {
        if (world.isClient) return ActionResult.SUCCESS;
        for (JsonElement e : Sheets.crate.getAsJsonArray("loadout")) {
            Item item = Registries.ITEM.get(ModItems.id(e.getAsString()));
            ItemStack stack = new ItemStack(item);
            if (item instanceof ArmorItem armor) {
                EquipmentSlot slot = armor.getSlotType();
                ItemStack old = player.getEquippedStack(slot);
                if (!old.isEmpty()) player.giveItemStack(old.copy());
                player.equipStack(slot, stack);
            } else {
                player.giveItemStack(stack);
            }
        }
        world.breakBlock(pos, false);
        ((ServerWorld) world).spawnParticles(ParticleTypes.CAMPFIRE_COSY_SMOKE,
                pos.getX() + 0.5, pos.getY() + 1.0, pos.getZ() + 0.5, 30, 0.4, 0.4, 0.4, 0.02);
        world.playSound(null, pos, SoundEvents.ITEM_ARMOR_EQUIP_CHAIN.value(), SoundCategory.PLAYERS, 1.0f, 1.0f);
        player.sendMessage(Text.literal(Sheets.crate.get("openMessage").getAsString()), true);
        return ActionResult.CONSUME;
    }
}

package gg.ghostdrop;

import com.google.gson.JsonObject;
import com.google.gson.JsonParser;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;

/** Loads the design sheets (JSON) that drive all numbers and content. Sheets are the source of truth. */
public final class Sheets {
    public static JsonObject weapons, armor, crate, mobs;

    public static void load() {
        weapons = read("weapons");
        armor = read("armor");
        crate = read("crate");
        mobs = read("mobs");
    }

    private static JsonObject read(String name) {
        String path = "/data/ghostdrop/sheets/" + name + ".json";
        try (var in = Sheets.class.getResourceAsStream(path)) {
            return JsonParser.parseReader(new InputStreamReader(in, StandardCharsets.UTF_8)).getAsJsonObject();
        } catch (Exception e) {
            throw new RuntimeException("Could not load sheet " + path, e);
        }
    }

    private Sheets() {}
}

package gg.ghostdrop;

import com.google.gson.JsonElement;
import com.google.gson.JsonObject;
import net.fabricmc.api.ModInitializer;
import net.fabricmc.fabric.api.event.lifecycle.v1.ServerTickEvents;
import net.minecraft.entity.EntityType;
import net.minecraft.entity.SpawnReason;
import net.minecraft.entity.mob.MobEntity;
import net.minecraft.particle.ParticleTypes;
import net.minecraft.registry.Registries;
import net.minecraft.server.network.ServerPlayerEntity;
import net.minecraft.server.world.ServerWorld;
import net.minecraft.sound.SoundCategory;
import net.minecraft.sound.SoundEvents;
import net.minecraft.text.Text;
import net.minecraft.util.Identifier;
import net.minecraft.util.math.BlockPos;
import net.minecraft.world.Heightmap;

public class GhostDropMod implements ModInitializer {
    @Override
    public void onInitialize() {
        Sheets.load();
        ModItems.register();
        ServerTickEvents.END_SERVER_TICK.register(server -> {
            if (server.getTicks() % 20 != 0) return; // check once per second
            String doneTag = Sheets.crate.get("doneTag").getAsString();
            int after = Sheets.crate.get("dropAfterTicks").getAsInt();
            for (ServerPlayerEntity p : server.getPlayerManager().getPlayerList()) {
                if (p.getCommandTags().contains(doneTag) || p.age < after) continue;
                p.addCommandTag(doneTag);
                dropCrate((ServerWorld) p.getWorld(), p);
            }
        });
    }

    private static void dropCrate(ServerWorld world, ServerPlayerEntity player) {
        int dist = Sheets.crate.get("dropDistance").getAsInt();
        double a = world.random.nextDouble() * Math.PI * 2;
        int x = player.getBlockX() + (int) (Math.cos(a) * dist);
        int z = player.getBlockZ() + (int) (Math.sin(a) * dist);
        int y = world.getTopY(Heightmap.Type.MOTION_BLOCKING_NO_LEAVES, x, z);
        BlockPos pos = new BlockPos(x, y, z);
        world.setBlockState(pos, ModItems.SUPPLY_CRATE.getDefaultState());
        world.spawnParticles(ParticleTypes.CAMPFIRE_SIGNAL_SMOKE, x + 0.5, y + 1, z + 0.5, 40, 0.2, 2.0, 0.2, 0.01);
        world.playSound(null, pos, SoundEvents.ENTITY_GENERIC_EXPLODE.value(), SoundCategory.BLOCKS, 0.6f, 1.4f);
        player.sendMessage(Text.literal(Sheets.crate.get("dropMessage").getAsString()), false);
        spawnSquad(world, player);
    }

    private static void spawnSquad(ServerWorld world, ServerPlayerEntity player) {
        JsonObject mobs = Sheets.mobs;
        int min = mobs.get("minRadius").getAsInt(), max = mobs.get("maxRadius").getAsInt();
        for (JsonElement e : mobs.getAsJsonArray("squad")) {
            JsonObject row = e.getAsJsonObject();
            EntityType<?> type = Registries.ENTITY_TYPE.get(Identifier.of(row.get("type").getAsString()));
            for (int i = 0; i < row.get("count").getAsInt(); i++) {
                double a = world.random.nextDouble() * Math.PI * 2;
                double r = min + world.random.nextDouble() * (max - min);
                int x = player.getBlockX() + (int) (Math.cos(a) * r);
                int z = player.getBlockZ() + (int) (Math.sin(a) * r);
                int y = world.getTopY(Heightmap.Type.MOTION_BLOCKING_NO_LEAVES, x, z);
                if (type.create(world) instanceof MobEntity mob) {
                    mob.refreshPositionAndAngles(x + 0.5, y, z + 0.5, world.random.nextFloat() * 360f, 0f);
                    mob.initialize(world, world.getLocalDifficulty(mob.getBlockPos()), SpawnReason.EVENT, null);
                    mob.setPersistent();
                    mob.setTarget(player);
                    world.spawnEntity(mob);
                }
            }
        }
    }
}

