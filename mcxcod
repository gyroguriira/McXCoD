package gg.ghostdrop;

import com.google.gson.JsonObject;
import net.minecraft.entity.projectile.ArrowEntity;
import net.minecraft.entity.projectile.PersistentProjectileEntity;
import net.minecraft.entity.player.PlayerEntity;
import net.minecraft.item.Item;
import net.minecraft.item.ItemStack;
import net.minecraft.item.Items;
import net.minecraft.sound.SoundCategory;
import net.minecraft.sound.SoundEvents;
import net.minecraft.util.Hand;
import net.minecraft.util.TypedActionResult;
import net.minecraft.world.World;

/** Quiet, fast, ammo-free "rifle": fires an arrow-speed round with a short cooldown. Values come from weapons.json. */
public class SuppressedRifleItem extends Item {
    private final int cooldown;
    private final float velocity, inaccuracy, soundVolume, soundPitch;
    private final double damage;

    public SuppressedRifleItem(Settings settings, JsonObject row) {
        super(settings);
        this.cooldown = row.get("cooldownTicks").getAsInt();
        this.velocity = row.get("velocity").getAsFloat();
        this.inaccuracy = row.get("inaccuracy").getAsFloat();
        this.damage = row.get("damage").getAsDouble();
        this.soundVolume = row.get("soundVolume").getAsFloat();
        this.soundPitch = row.get("soundPitch").getAsFloat();
    }

    @Override
    public TypedActionResult<ItemStack> use(World world, PlayerEntity player, Hand hand) {
        ItemStack stack = player.getStackInHand(hand);
        if (!world.isClient) {
            ArrowEntity round = new ArrowEntity(world, player, new ItemStack(Items.ARROW), null);
            round.setVelocity(player, player.getPitch(), player.getYaw(), 0.0f, velocity, inaccuracy);
            round.setDamage(damage);
            round.pickupType = PersistentProjectileEntity.PickupPermission.DISALLOWED;
            world.spawnEntity(round);
            world.playSound(null, player.getX(), player.getY(), player.getZ(),
                    SoundEvents.ENTITY_ARROW_SHOOT, SoundCategory.PLAYERS, soundVolume, soundPitch);
        }
        player.getItemCooldownManager().set(this, cooldown);
        return TypedActionResult.success(stack, world.isClient());
    }
}

package gg.ghostdrop;

import com.google.gson.JsonElement;
import com.google.gson.JsonObject;
import java.util.EnumMap;
import java.util.List;
import java.util.Map;
import net.minecraft.block.AbstractBlock;
import net.minecraft.block.Block;
import net.minecraft.block.Blocks;
import net.minecraft.block.MapColor;
import net.minecraft.block.sound.BlockSoundGroup;
import net.minecraft.item.ArmorItem;
import net.minecraft.item.ArmorMaterial;
import net.minecraft.item.BlockItem;
import net.minecraft.item.Item;
import net.minecraft.item.SwordItem;
import net.minecraft.item.ToolMaterials;
import net.minecraft.recipe.Ingredient;
import net.minecraft.registry.Registries;
import net.minecraft.registry.Registry;
import net.minecraft.registry.entry.RegistryEntry;
import net.minecraft.sound.SoundEvents;
import net.minecraft.util.Identifier;

/** Registers everything listed in the sheets. */
public final class ModItems {
    public static Block SUPPLY_CRATE;

    public static void register() {
        JsonObject crate = Sheets.crate;
        SUPPLY_CRATE = Registry.register(Registries.BLOCK, id(crate.get("id").getAsString()),
                new SupplyCrateBlock(AbstractBlock.Settings.create().mapColor(MapColor.OLIVE_GREEN)
                        .strength(1.5f).sounds(BlockSoundGroup.WOOD)));
        Registry.register(Registries.ITEM, id(crate.get("id").getAsString()),
                new BlockItem(SUPPLY_CRATE, new Item.Settings()));

        // Armor (Ghost look)
        JsonObject mat = Sheets.armor.getAsJsonObject("material");
        Map<ArmorItem.Type, Integer> defense = new EnumMap<>(ArmorItem.Type.class);
        for (JsonElement e : Sheets.armor.getAsJsonArray("pieces")) {
            JsonObject p = e.getAsJsonObject();
            defense.put(typeOf(p.get("slot").getAsString()), p.get("defense").getAsInt());
        }
        defense.putIfAbsent(ArmorItem.Type.BODY, 6);
        RegistryEntry<ArmorMaterial> material = Registry.registerReference(Registries.ARMOR_MATERIAL,
                id(mat.get("layer").getAsString()),
                new ArmorMaterial(defense, mat.get("enchantability").getAsInt(),
                        SoundEvents.ITEM_ARMOR_EQUIP_LEATHER, () -> Ingredient.ofItems(net.minecraft.item.Items.IRON_INGOT),
                        List.of(new ArmorMaterial.Layer(id(mat.get("layer").getAsString()))),
                        mat.get("toughness").getAsFloat(), mat.get("knockbackResistance").getAsFloat()));
        int mult = mat.get("durabilityMultiplier").getAsInt();
        for (JsonElement e : Sheets.armor.getAsJsonArray("pieces")) {
            JsonObject p = e.getAsJsonObject();
            ArmorItem.Type type = typeOf(p.get("slot").getAsString());
            Registry.register(Registries.ITEM, id(p.get("id").getAsString()),
                    new ArmorItem(material, type, new Item.Settings().maxDamage(type.getMaxDamage(mult))));
        }

        // Weapons
        JsonObject rifle = Sheets.weapons.getAsJsonObject("rifle");
        Registry.register(Registries.ITEM, id(rifle.get("id").getAsString()),
                new SuppressedRifleItem(new Item.Settings().maxCount(1), rifle));
        JsonObject knife = Sheets.weapons.getAsJsonObject("knife");
        Registry.register(Registries.ITEM, id(knife.get("id").getAsString()),
                new SwordItem(ToolMaterials.IRON, new Item.Settings().attributeModifiers(
                        SwordItem.createAttributeModifiers(ToolMaterials.IRON,
                                knife.get("attackDamage").getAsInt(), knife.get("attackSpeed").getAsFloat()))));
    }

    public static Identifier id(String path) { return Identifier.of("ghostdrop", path); }

    private static ArmorItem.Type typeOf(String slot) {
        return switch (slot) {
            case "helmet" -> ArmorItem.Type.HELMET;
            case "chestplate" -> ArmorItem.Type.CHESTPLATE;
            case "leggings" -> ArmorItem.Type.LEGGINGS;
            case "boots" -> ArmorItem.Type.BOOTS;
            default -> throw new IllegalArgumentException("Unknown armor slot in sheet: " + slot);
        };
    }

    private ModItems() {}
}

